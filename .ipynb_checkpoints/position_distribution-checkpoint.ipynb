   "source": [
    "#set x-axis limits so that histogram is centered\n",
    "xmin = 0\n",
    "xmax = np.ceil(mu)*2\n",
    "\n",
    "#plot histogram \n",
    "ax = df_diff_n.plot('Diff_y',#,+diff, \n",
    "        kind='hist', \n",
    "        bins=custom_bins,\n",
    "        density=False,\n",
    "        weights = bin_weights,\n",
    "        title = 'Histogram of Diff_'+diff+': μ ='+str(np.round(mu,2))+', σ ='+str(np.round(std,2)),\n",
    "        ylabel = 'Events', \n",
    "        xlabel='Gen - Rec (cm)',\n",
    "        rot = 0,\n",
    "        color='blue',\n",
    "        legend = None,\n",
    "        figsize=(6, 4),\n",
    "        alpha=0.3)\n",
    "\n",
    "#plot gaussian fit\n",
    "ax.plot(custom_bins, g*g_weight, color='red', linestyle='dashed')\n",
    "\n",
    "#set plot parameters\n",
    "ax.set_axisbelow(True)\n",
