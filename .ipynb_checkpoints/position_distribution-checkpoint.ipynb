   "source": [
    "#set up histogram bining for one event\n",
    "diff = 'y'\n",
    "bin_n = 40\n",
    "bin_width = (np.ceil(df_diff_n['Diff_'+diff].max()) - np.floor(df_diff_n['Diff_'+diff].min()))/bin_n\n",
    "custom_bins = np.arange(np.floor(df_diff_n['Diff_'+diff].min()), np.ceil(df_diff_n['Diff_'+diff].max()), bin_width)\n",
    "\n",
    "custom_bins"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "ce71b626-2ffe-4179-88a9-0cba3b890b16",
   "metadata": {},
   "outputs": [],
   "source": [
    "#custom binning for better fit\n",
    "bin_min = -3.5\n",
    "bin_max = 3.5\n",
    "#bin_n = 80\n",
    "#bin_width = (bin_max - bin_min)/bin_n\n",
    "#custom_bins = np.arange(bin_min, bin_max, bin_width)\n",
    "\n",
    "df_diff_n = df_diff_n[(df_diff_n['Diff_'+diff]>=bin_min) & (df_diff_n['Diff_'+diff]<=bin_max)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "5621ccf8-47e3-4a4b-9d8e-36e6727c4d9b",
   "metadata": {},
   "outputs": [],
   "source": [
    "#set up bins weights so that summing the bars up gives 1\n",
    "bin_weights = np.ones_like(df_diff_n['Diff_'+diff]) / len(df_diff_n['Diff_'+diff])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "b5edbed3-3ec8-4ad5-858f-4c9c0c000c00",
   "metadata": {},
   "outputs": [],
   "source": [
    "#fit data to gaussian distribution\n",
    "mu, std = scipy.stats.norm.fit(df_diff_n['Diff_'+diff])\n",
    "g = scipy.stats.norm.pdf(custom_bins, mu, std)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "9e3f162b-48d3-41b3-9e32-a68a3c93ebb3",
   "metadata": {},
   "outputs": [],
   "source": [
    "#get fit weight correction for weighted/density histogram\n",
    "sums_w, bins_w = np.histogram(df_diff_n['Diff_'+diff], custom_bins, weights = bin_weights)\n",
    "sums_d, bins_d = np.histogram(df_diff_n['Diff_'+diff], custom_bins, density = True)\n",
    "g_weight = np.amax(sums_w)/np.amax(sums_d)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "b49e71ed-1238-449d-b797-3d6519c63ef7",
   "metadata": {},
